# What:     Template for the local .env file (copy to .env and fill in).
# In:       Your own values; .env itself is gitignored.
# Out:      Environment variables read by app/config.py (from M3).
# Fails if: The key for the chosen LLM_PROVIDER is left blank, so live jobs fail with a clear error (mocked tests still pass).

# Which LLM answers: gemini (default, free tier) or anthropic.
LLM_PROVIDER=gemini
# Gemini API key (Google AI Studio). Free tier: Google may use the data; send synthetic invoices only.
GEMINI_API_KEY=
# Only needed with LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Model id for the chosen provider; empty means gemini-3.5-flash-lite / claude-opus-5-5.
LLM_MODEL=
# Anthropic only. Reasoning effort: low | medium | high | xhigh | max. Empty means medium.
LLM_EFFORT=
# Rasterization resolution for OCR'd pages. 300 is the usual Tesseract sweet spot.
OCR_DPI=300
# Where uploads and results are stored (gitignored).
DATA_DIR=./data
# Largest accepted upload, in MB.
MAX_UPLOAD_MB=20
# Only needed if the tesseract binary isn't on PATH.
TESSERACT_CMD=
