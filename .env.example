# What:     Template for the local .env file (copy to .env and fill in).
# In:       Your own values; .env itself is gitignored.
# Out:      Environment variables read by app/config.py (from M3).
# Fails if: ANTHROPIC_API_KEY is left blank, so live extraction calls are rejected (mocked tests still pass).

ANTHROPIC_API_KEY=
# Model id. The default is set in M3 from Anthropic's current model list.
LLM_MODEL=
# Rasterization resolution for OCR'd pages. 300 is the usual Tesseract sweet spot.
OCR_DPI=300
# Where uploads and results are stored (gitignored).
DATA_DIR=./data
# Only needed if the tesseract binary isn't on PATH.
TESSERACT_CMD=
